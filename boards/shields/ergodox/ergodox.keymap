/ {
    combos {
        compatible = "zmk,combos";
        combo_boot_left {
            timeout-ms = <100>;
            key-positions = <0 6>;
            bindings = <&bootloader>;
        };
        combo_boot_right {
            timeout-ms = <100>;
            key-positions = <7 13>;
            bindings = <&bootloader>;
        };
    };

